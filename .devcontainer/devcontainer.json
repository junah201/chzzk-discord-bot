{
  "name": "chzzk",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/lambdas"
  },
  "containerEnv": {
    "AWS_DEFAULT_REGION": "ap-northeast-2",
    "AWS_REGION": "ap-northeast-2"
  },
  "mounts": ["source=uv-cache,target=/home/node/.cache/uv,type=volume"],
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "amazonwebservices.aws-toolkit-vscode",
        "redhat.vscode-yaml",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "python.defaultInterpreterPath": "/workspaces/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.analysis.extraPaths": ["lambdas"],
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["lambdas"],
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[yaml]": {
          "editor.defaultFormatter": "redhat.vscode-yaml"
        },
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        }
      }
    }
  },
  "updateContentCommand": "npm install -g serverless@3",
  "postCreateCommand": "uv sync",
  "remoteUser": "node"
}
