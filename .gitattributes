# Default: normalize text files to LF
* text=auto eol=lf

# Explicit text files
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.toml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf

# Windows-specific scripts
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary